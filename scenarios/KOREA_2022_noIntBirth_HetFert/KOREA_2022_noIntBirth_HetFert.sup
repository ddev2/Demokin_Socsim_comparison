* >>> new file, start
*************************************************************************
* Supervisory file for KOREA_2022_noIntBirth_HetFert
* Missing combination of bint and hetfert in the design of Table 1.
* Rates, marriage file and initial population copied unchanged from KOREA_2022,
* so that the run differs from KOREA_2022 only by bint and hetfert.
*************************************************************************
segments  1
input_file presim

random_father 1
marriage_after_childbirth 0 
marriage_eval distribution
marriage_queues 1
hetfert 1
bint 0

*************************************************************************
* Run for 200 years, as KOREA_2022, in order to have full kinship networks
duration 2400
include rates/fert
include rates/marriage
include rates/mort
run
* <<< end
