* >>> new file, start
*************************************************************************
* Supervisory file for TFR=5_LM_HetFert_noIntBirth
* Missing combination of bint and hetfert in the design of Table 1.
* Rates, marriage file and initial population copied unchanged from TFR=5_LM,
* so that the run differs from TFR=5_LM only by bint and hetfert.
*************************************************************************
segments  1
input_file presim

random_father 1
marriage_after_childbirth 0 
marriage_eval distribution
marriage_queues 1
hetfert 1
bint 0

*************************************************************************
* Run for 250 years, as TFR=5_LM, in order to have full kinship networks
duration 3000
include rates/fert
include rates/marriage
include rates/mort
run
* <<< end
